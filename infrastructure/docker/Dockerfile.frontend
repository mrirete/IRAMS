FROM node:22-alpine AS builder
WORKDIR /app

# Install dependencies
COPY src/frontend/package.json src/frontend/package-lock.json* ./
RUN npm ci || npm install

# Build application — provide placeholder env vars for Docker build
# (real values are injected at runtime via nginx/env substitution)
COPY src/frontend/ ./
ENV VITE_SUPABASE_URL=https://placeholder.supabase.co
ENV VITE_SUPABASE_ANON_KEY=placeholder-key
ENV VITE_GATEWAY_URL=http://localhost:8000
# Skip tsc in Docker — type checking is done by frontend-tests CI job.
# Only vite build is needed for the production bundle.
RUN npx vite build

FROM nginx:alpine
# Copy built assets to NGINX serve directory
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom NGINX config if needed for SPA routing
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

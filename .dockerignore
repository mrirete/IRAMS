# Ignore frontend build artifacts and node_modules
src/frontend/node_modules
src/frontend/dist
src/frontend/.next

# Ignore infrastructure (except docker configs needed by Dockerfile)
infrastructure/*
!infrastructure/docker

# Ignore git
.git
.gitignore

# Ignore IDE/editor files
.vscode
.idea
*.pyc
__pycache__
*.pyo
.mypy_cache
.pytest_cache

# Ignore docs and non-essential files
*.md
LICENSE

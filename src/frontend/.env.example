# ═══════════════════════════════════════════════════════════
# ERS Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or .env to version control!
# ═══════════════════════════════════════════════════════════

# ── Supabase (Required) ─────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── ERS Backend API (Railway) ───────────────────────────
# The FastAPI gateway hosting all Layer 2/3 modules.
# Production: https://irams-production.up.railway.app/api/v1
# Local dev:  http://localhost:8000/api/v1
VITE_ERS_API_URL=http://localhost:8000/api/v1

# ── AI Configuration ────────────────────────────────────
# Routes AI calls through the backend proxy (Gemini key stays server-side).
# In production, this is the same Railway URL as VITE_ERS_API_URL.
VITE_AI_PROXY_URL=http://localhost:8000/api/v1

# DEVELOPMENT ONLY — Direct Gemini access (never use in production):
# VITE_GEMINI_API_KEY=your-gemini-api-key


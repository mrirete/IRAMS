# ═══════════════════════════════════════════════════════════
# ERS Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or .env to version control!
# ═══════════════════════════════════════════════════════════

# ── Supabase (Required) ─────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AI Configuration ────────────────────────────────────
# OPTION 1 (RECOMMENDED for production):
# Route ALL AI calls through the backend proxy.
# The Gemini API key stays server-side — never exposed in the browser.
VITE_AI_PROXY_URL=http://localhost:8010/api/v1

# OPTION 2 (Development only):
# Direct Gemini access from the browser. DO NOT use in production!
# If VITE_AI_PROXY_URL is set, this key is ignored.
# VITE_GEMINI_API_KEY=your-gemini-api-key

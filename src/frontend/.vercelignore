# ── Test & development files ─────────────────────────────
check_*.js
test_*.cjs
test_*.js
test_*.ts
tsc_output.txt
fix_*.ps1
restore_files.ps1
generate-pages.js

# ── Build artifacts (force Vercel to run buildCommand) ────
dist
dist-ssr

# ── Local Supabase CLI ───────────────────────────────────
# Migrations, baseline and Edge Function sources stay out of the upload —
# EXCEPT the modules the browser shares with an Edge Function. gitignore
# syntax cannot re-include a file under an excluded directory, so each
# level is opened explicitly. Add a pair of lines per shared file.
supabase/*
!supabase/functions/
supabase/functions/*
!supabase/functions/agent-run/
supabase/functions/agent-run/*
!supabase/functions/agent-run/pidGraph.ts

# ── Standalone sub-apps (not imported by main app) ────────
# NOTE (2026-07-27): this used to claim agent-panel/ and dashboards/ were
# imported by AppLayout.tsx and HomePage.tsx. Neither is true any more —
# AppLayout no longer imports AgentPanel, and HomePage is itself unreached.
# Left un-ignored (they cost only build time) until the dead-file triage
# decides their fate: `npm run deadcode`.
mobile/

# ── Environment secrets ──────────────────────────────────
.env
.env.local
.env.production
.env.*.local

# ── IDE / OS ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
